{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openkita:skill:event-planner:0.1.0:schema",
  "title": "Event plan draft (model output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "event",
    "checklist",
    "invitation",
    "calendar_entry_draft",
    "missing_information",
    "warnings"
  ],
  "$defs": {
    "time": {
      "description": "HH:MM (24 h) or a placeholder such as [Uhrzeit Beginn]",
      "type": "string",
      "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|\\[[^\\]]+\\])$"
    },
    "date_iso": {
      "description": "ISO date only when day, month and year are given in the input; otherwise null",
      "type": ["string", "null"],
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "properties": {
    "language": { "enum": ["de", "en", "tr", "ar"] },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "title", "date", "date_iso", "start_time", "end_time", "location", "audience", "description"],
      "properties": {
        "event_type": { "enum": ["summer_party", "lantern_walk", "parents_evening", "excursion", "other"] },
        "title": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 50 },
        "date_iso": { "$ref": "#/$defs/date_iso" },
        "start_time": { "$ref": "#/$defs/time" },
        "end_time": { "$ref": "#/$defs/time" },
        "location": { "type": "string", "maxLength": 150 },
        "audience": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeframe", "task", "responsible", "source", "done"],
        "properties": {
          "timeframe": {
            "enum": ["4 Wochen vorher", "2 Wochen vorher", "1 Woche vorher", "Am Vortag", "Am Veranstaltungstag", "Danach"]
          },
          "task": { "type": "string", "maxLength": 300 },
          "responsible": { "type": "string", "maxLength": 100 },
          "source": { "enum": ["input", "suggestion"] },
          "done": { "const": false }
        }
      }
    },
    "invitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "salutation", "body_paragraphs", "call_to_action", "closing", "greeting", "signature"],
      "properties": {
        "subject": { "type": "string", "minLength": 3, "maxLength": 150 },
        "salutation": { "type": "string", "minLength": 2, "maxLength": 100 },
        "body_paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 1500 }
        },
        "call_to_action": { "type": ["string", "null"], "maxLength": 500 },
        "closing": { "type": "string", "maxLength": 200 },
        "greeting": { "type": "string", "minLength": 2, "maxLength": 60 },
        "signature": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "calendar_entry_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "date_iso", "start_time", "end_time", "location", "note", "status"],
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 50 },
        "date_iso": { "$ref": "#/$defs/date_iso" },
        "start_time": { "$ref": "#/$defs/time" },
        "end_time": { "$ref": "#/$defs/time" },
        "location": { "type": "string", "maxLength": 150 },
        "note": { "type": "string", "maxLength": 500 },
        "status": { "const": "draft_requires_approval" }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["placeholder", "question"],
        "properties": {
          "placeholder": { "type": "string", "pattern": "^\\[[^\\]]+\\]$" },
          "question": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 300 } }
  }
}
