{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openkita:skill:parent-communication:0.1.0:schema",
  "title": "Parent communication draft (model output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "message_type",
    "tone",
    "subject",
    "salutation",
    "body_paragraphs",
    "call_to_action",
    "closing",
    "greeting",
    "signature",
    "key_facts",
    "missing_information",
    "warnings"
  ],
  "properties": {
    "language": { "enum": ["de", "en", "tr", "ar"] },
    "message_type": {
      "enum": ["announcement", "invitation", "reminder", "information", "closure_notice", "request", "other"]
    },
    "tone": { "enum": ["friendly", "neutral", "formal", "warm"] },
    "subject": { "type": "string", "minLength": 3, "maxLength": 150 },
    "salutation": { "type": "string", "minLength": 2, "maxLength": 100 },
    "body_paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 1500 }
    },
    "call_to_action": { "type": ["string", "null"], "maxLength": 500 },
    "closing": { "type": "string", "maxLength": 200 },
    "greeting": { "type": "string", "minLength": 2, "maxLength": 60 },
    "signature": { "type": "string", "minLength": 1, "maxLength": 200 },
    "key_facts": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "maxLength": 60 },
          "value": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["placeholder", "question"],
        "properties": {
          "placeholder": { "type": "string", "pattern": "^\\[[^\\]]+\\]$" },
          "question": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 }
    }
  }
}
