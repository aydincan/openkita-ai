{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openkita:skill:meeting-minutes:0.1.0:schema",
  "title": "Meeting minutes draft (model output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "meeting_type",
    "title",
    "meta",
    "agenda_items",
    "tasks",
    "next_meeting",
    "missing_information",
    "warnings"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "properties": {
    "language": {
      "enum": [
        "de",
        "en"
      ]
    },
    "meeting_type": {
      "enum": [
        "team_meeting",
        "parents_council",
        "parents_evening",
        "planning",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 150
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time",
        "location",
        "chair",
        "minute_taker",
        "participants",
        "absent"
      ],
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 50
        },
        "time": {
          "type": "string",
          "maxLength": 50
        },
        "location": {
          "type": "string",
          "maxLength": 150
        },
        "chair": {
          "type": "string",
          "maxLength": 100
        },
        "minute_taker": {
          "type": "string",
          "maxLength": 100
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "absent": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "agenda_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "topic",
          "summary",
          "decisions",
          "open_questions"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "topic": {
            "type": "string",
            "maxLength": 150
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "open_questions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "responsible",
          "due",
          "agenda_item",
          "status"
        ],
        "properties": {
          "task": {
            "type": "string",
            "maxLength": 300
          },
          "responsible": {
            "type": "string",
            "maxLength": 100
          },
          "due": {
            "type": "string",
            "maxLength": 50
          },
          "agenda_item": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "status": {
            "const": "open"
          }
        }
      }
    },
    "next_meeting": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 150
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "placeholder",
          "question"
        ],
        "properties": {
          "placeholder": {
            "type": "string",
            "pattern": "^\\[[^\\]]+\\]$"
          },
          "question": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
