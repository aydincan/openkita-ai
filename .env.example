# OpenKita AI - configuration. Copy to `.env` (repo root) and adapt:  cp .env.example .env
# Used by Docker Compose AND by local backend development (the backend reads the root .env).
# This file contains NO real secrets. Values with special characters: use single quotes.

# ---- General -----------------------------------------------------------------
# production  = default for Docker: interactive API docs (/docs) disabled, strict API CSP.
# development = enables /docs and /redoc (they load assets from a CDN) - use for local dev only.
APP_ENV=production             # production | development | test
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ---- Database (PostgreSQL with pgvector) ------------------------------------
# REQUIRED. Left empty on purpose. Docker Compose refuses to start while POSTGRES_PASSWORD is
# empty. The database entrypoint and the backend refuse placeholders such as "change-me".
# Any characters are allowed, e.g.  POSTGRES_PASSWORD='p@ss/w0rd:#?'
POSTGRES_PASSWORD=
POSTGRES_USER=openkita
POSTGRES_DB=openkita
# Local development outside Docker. Docker Compose overrides host/port for the backend (db:5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: full URL override (must be URL-encoded; wins over POSTGRES_*). Normally leave unset.
# DATABASE_URL=postgresql+asyncpg://user:pw@localhost:5432/openkita

# ---- Backend -----------------------------------------------------------------
# Comma-separated browser origins allowed to call the backend directly (CORS).
CORS_ORIGINS=http://localhost:3000
# Upper bound in seconds (max 5) for each dependency check done by GET /health.
HEALTH_CHECK_TIMEOUT_SECONDS=3

# ---- AI (local-first) --------------------------------------------------------
# "ollama" = local Ollama (start it with `docker compose --profile ollama up`);
# "none"   = run without AI; the status panel then shows the AI provider as disabled.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434     # Compose sets http://ollama:11434 for the backend
OLLAMA_MODEL=llama3.1:8b
# Seconds for one local generation (parent letter). Health checks stay on the short timeout above.
# OLLAMA_GENERATE_TIMEOUT_SECONDS=120
# Directory of skill folders. Local default is the repo skills/ directory.
# Compose mounts that directory at /srv/skills and sets SKILLS_DIR=/srv/skills.
# SKILLS_DIR=
# External AI is NOT supported yet and must stay false. The backend refuses to
# start if this is true (fail closed) until the Privacy Gateway exists.
EXTERNAL_AI_ENABLED=false

# ---- Sessions ----------------------------------------------------------------
# HttpOnly cookie lifetime in hours (1–168). Leave this false for local HTTP.
# A public HTTPS deployment must set SESSION_COOKIE_SECURE=true.
# SESSION_TTL_HOURS=12
# SESSION_COOKIE_SECURE=false

# ---- Frontend ----------------------------------------------------------------
# Where the frontend SERVER reaches the backend (never sent to the browser).
# Compose overrides this with http://backend:8000.
BACKEND_INTERNAL_URL=http://localhost:8000
# Max wait (ms) of the frontend's /api/health proxy for the backend. Only 7000–9000 is
# accepted (must outlast the backend health check: max 5 s + 1 s); otherwise 8000 is used.
# BACKEND_TIMEOUT_MS=8000
# Longer wait (ms) for POST /api/backend/drafts/parent-communication. 10000–300000, else 130000.
# BACKEND_GENERATE_TIMEOUT_MS=130000
# Public browser origin (scheme and host). Leave unset on localhost. Set it when a
# reverse proxy's Host differs from the public site. A public HTTPS deployment must
# still set SESSION_COOKIE_SECURE=true.
# PUBLIC_ORIGIN=https://kita.example
# Privacy: opt out of Next.js anonymous telemetry when running `npm run dev` / `npm run build`
# locally (the Docker image already does this). Export it in your shell:
#   export NEXT_TELEMETRY_DISABLED=1      (or: npx next telemetry disable)

# ---- Docker Compose ports (bound to 127.0.0.1 only) ---------------------------
# DB_PORT is only used by deployment/docker/compose.dev.yml (publishes the database).
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
OLLAMA_PORT=11434
